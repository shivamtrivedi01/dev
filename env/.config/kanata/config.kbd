;; Caps to escape/control configuration for Kanata

(defsrc
  caps 8 9
)

(defvar
  tap-time 80
  hold-time 150
)

(defalias
  escctrl (tap-hold 100 100 esc lctl)
  8 (multi f24 (tap-hold $tap-time $hold-time 8 ralt))
  9 (multi f24 (tap-hold $tap-time $hold-time 9 rmet))

)

(deflayer base
  @escctrl @8  @9
)
